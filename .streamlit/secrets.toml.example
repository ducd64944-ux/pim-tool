# Dán nội dung này vào Streamlit Cloud → app → Settings → Secrets (KHÔNG commit file secrets thật lên GitHub).

# ---- Kho dữ liệu (repo PRIVATE riêng cho dữ liệu, khác repo code) ----
GITHUB_TOKEN = "github_pat_xxx"          # Fine-grained token: chỉ repo dữ liệu, quyền Contents: Read and write
GITHUB_DATA_REPO = "ducd64944-ux/pim-tool-data"
GITHUB_BRANCH = "main"
# DATA_ROOT = "data"                     # thư mục gốc trong repo dữ liệu (mặc định "data")
# SHARED_EDIT = "admin"                  # "admin" (mặc định): chỉ admin sửa cấu hình/mapping dùng chung; "all": ai cũng sửa được

# ---- AI miễn phí (tuỳ chọn) — gợi ý lỗi sai, hỏi AI, đề xuất tính năng ----
# AI_PROVIDER = "groq"                   # "groq" (khuyên dùng) | "gemini" | "openrouter"
# AI_API_KEY = "gsk_xxx"                 # key free: console.groq.com/keys | aistudio.google.com/apikey | openrouter.ai/keys
# AI_MODEL = "openai/gpt-oss-120b"       # để trống = mặc định của nhà cung cấp; trang 👥 Quản trị có nút "Liệt kê model"

# ---- Tài khoản: mỗi tài khoản 1 workspace riêng, admin xem/sửa được mọi workspace ----
[users.ducd]
password = "doi-mat-khau-nay"            # hoặc "sha256:<chuỗi băm>" — tạo ở trang 👥 Quản trị
ten = "Đức"
admin = true

